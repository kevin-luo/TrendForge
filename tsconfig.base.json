{
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": true,
    "lib": ["ES2022", "DOM"],
    "allowJs": false,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "forceConsistentCasingInFileNames": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": false,
    "baseUrl": ".",
    "paths": {
      "@trendforge/core": ["packages/core/src/index.ts"],
      "@trendforge/content-matrix": ["packages/content-matrix/src/index.ts"],
      "@trendforge/connectors": ["packages/connectors/src/index.ts"],
      "@trendforge/llm": ["packages/llm/src/index.ts"],
      "@trendforge/tts": ["packages/tts/src/index.ts"],
      "@trendforge/subtitles": ["packages/subtitles/src/index.ts"],
      "@trendforge/ffmpeg": ["packages/ffmpeg/src/index.ts"],
      "@trendforge/motion-core": ["packages/motion-core/src/index.ts"],
      "@trendforge/motion-director": ["packages/motion-director/src/index.ts"],
      "@trendforge/motion-presets": ["packages/motion-presets/src/index.ts"],
      "@trendforge/motion-render": ["packages/motion-render/src/index.ts"],
      "@trendforge/render-lint": ["packages/render-lint/src/index.ts"],
      "@trendforge/product-video": ["packages/product-video/src/index.ts"],
      "@trendforge/renderer-remotion": ["apps/renderer-remotion/src/render.ts"],
      "@trendforge/renderer-remotion/types": ["apps/renderer-remotion/src/types.ts"],
      "@trendforge/templates": ["packages/templates/src/index.ts"],
      "@trendforge/renderer": ["apps/renderer/src/index.ts"],
      "@trendforge/renderer/html-renderer": ["apps/renderer/src/html-renderer.ts"]
    }
  }
}
